# ===========================================
# Environment Variables — Capstone Frontend
# ===========================================
# Salin file ini ke .env.local, lalu isi nilainya sesuai environment lokal kamu.
# JANGAN commit .env.local ke git (sudah ada di .gitignore).

# URL backend API (Express.js)
VITE_API_URL=http://localhost:3000

# URL server Socket.io (biasanya sama dengan API URL)
VITE_SOCKET_URL=http://localhost:3000
