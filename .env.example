# ===========================================
# Environment Variables — Capstone Frontend
# ===========================================
# Salin file ini ke .env.local untuk development lokal.
# JANGAN commit .env.local ke git.

# URL backend API (Express.js)
VITE_API_URL=

# URL server Socket.io (biasanya sama dengan API URL)
VITE_SOCKET_URL=http://localhost:3000

# VITE_USE_AUTH_MOCK=false
# VITE_USE_INVENTORY_MOCK=true
# VITE_USE_TRANSACTION_MOCK=true
# VITE_USE_INVOICE_MOCK=true
# VITE_USE_REPORT_ISSUE_MOCK=true

VITE_DEFAULT_AUTH_ROLE=admin

